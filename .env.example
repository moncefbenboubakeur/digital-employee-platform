DATABASE_URL="file:/private/tmp/digital-employee-platform-dev.db"
STORAGE_DIR="./storage"
ADMIN_PASSWORD="pilot-admin"
ADMIN_SESSION_SECRET="change-this-before-a-real-pilot"

# Optional local XTTS voice generation. This prototype can still fall back to
# browser TTS if VOICE_COMMAND is unset.
# VOICE_COMMAND="scripts/voice-venv/bin/python scripts/generate_voice.py --text-file '{scriptPath}' --reference '{voiceReferencePath}' --language '{language}' --output '{audioPath}'"
# VOICE_COMMAND_TIMEOUT_SEC=600

# Recommended: persistent xtts worker. Keeps the ~1.5 GB Coqui model loaded
# in RAM and services requests over JSON-line stdin/stdout, removing the
# ~30–60s Python+torch+model startup cost from every generation. The admin
# UI (Settings → Persistent xtts worker) has Start/Stop buttons once this
# is set. Falls back to VOICE_COMMAND if VOICE_WORKER_COMMAND is unset.
# VOICE_WORKER_COMMAND="scripts/voice-venv/bin/python scripts/voice_worker.py"

# ============================================================================
# LLM-backed receptionist features
# ============================================================================
# Both features below route through LAPI (the local llmbridge daemon at
# http://127.0.0.1:9999 — see https://github.com/moncefbenboubakeur/LAPI).
# DEP does NOT hold provider credentials anymore. The LAPI daemon owns the
# Anthropic / OpenAI / Google credentials (or subscription CLIs); DEP only
# reads ~/.llmbridge/auth.token to authenticate to the daemon.
#
# Daemon-side per-project config lives under ~/.llmbridge/projects/:
#   - dep-match.yaml      → picks backend for the matcher
#   - dep-drafter.yaml    → picks backend for the drafter
# Changing which provider/model handles each call is a daemon-side YAML
# edit, NOT a DEP code change. See docs/lapi-setup.md.

# Optional: LLM-backed draft answers for unknown visitor questions. When
# enabled, every new unknown question fires an LLM call (via LAPI) in the
# background; the result lands as a "draft" on the admin review queue for
# a human to edit and approve. Drafts are persisted as JSON files under
# ${STORAGE_DIR}/unknown-drafts/. The kiosk path never waits on this call.
# DR_LLM_DRAFTS=1

# Optional: LLM-backed semantic match. When enabled, if the kiosk's keyword
# matcher fails on a visitor question, the server calls the LAPI matcher to
# pick the best approved answer from the catalog (e.g. "what time does it
# close" correctly matches the "opening hours" answer). Adds ~0.5-7s latency
# (varies by backend chosen in the daemon YAML) to misses only — hits stay
# instant. Independent of DR_LLM_DRAFTS.
# DR_LLM_MATCH=1

# Optional LAPI overrides (defaults usually fine):
# LAPI_BASE_URL=http://127.0.0.1:9999
# LAPI_TOKEN_PATH=~/.llmbridge/auth.token

# Optional: local multilingual embeddings worker for the matcher's pre-filter.
# When enabled, the matcher embeds the catalog once + each visitor question,
# uses cosine similarity to pick the top-8 most-likely candidates, and sends
# only those to the LLM. This brings matcher latency from ~7-19s (full
# 50-entry catalog through the LLM) down to ~1-3s (small LLM call).
#
# Uses sentence-transformers' paraphrase-multilingual-MiniLM-L12-v2 (~120 MB)
# in the existing Python venv. Strong cross-lingual similarity for AR/FR/EN.
# Pre-filter runs entirely offline; no API key, no network round-trip.
#
# First-call startup is ~8s (model load); subsequent embeddings are ~30-50ms.
# Catalog vectors are cached in memory for the lifetime of the Next.js process.
#
# EMBEDDINGS_WORKER_COMMAND="'/Volumes/My Book Duo-1/Dev/AlgeriaTechGen/scripts/voice-venv/bin/python' scripts/embeddings_worker.py"
